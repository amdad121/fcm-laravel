{
    "name": "amdadulhaq/fcm-laravel",
    "description": "A simple, lightweight, fast Firebase Cloud Messaging (FCM) notification channel for Laravel.",
    "keywords": [
        "Amdadul Haq",
        "laravel",
        "fcm-laravel",
        "firebase",
        "fcm",
        "push-notifications"
    ],
    "homepage": "https://github.com/amdad121/fcm-laravel",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Amdadul Haq",
            "email": "amdadulhaq781@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "google/auth": "^1.53",
        "illuminate/notifications": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "AmdadulHaq\\Fcm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmdadulHaq\\Fcm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmdadulHaq\\Fcm\\FcmServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
